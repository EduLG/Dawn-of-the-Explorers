# Local development values. They match the db service in docker-compose.yml,
# which exposes PostgreSQL on localhost:5433, so running Flask from the venv
# uses the same database as `docker compose up`.
DATABASE_URL=postgresql://vtt_user:vtt_password@localhost:5433/vtt_db
JWT_SECRET_KEY=dev_secret_key
FLASK_DEBUG=True
FRONTEND_URL=http://localhost:5173
